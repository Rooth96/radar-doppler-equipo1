- name: snippet_0
  id: snippet
  parameters:
    alias: ''
    code: "import json\nfrom pathlib import Path\nfrom datetime import datetime\n\nrepo_root = Path(__file__).resolve().parents[2]\nscenario_root = repo_root / \"caso_02_vehiculo_30kmh\"\nconfig_dir = scenario_root / \"config\"\nconfig_dir.mkdir(parents=True, exist_ok=True)\n\nconfig = {\n    \"timestamp\": datetime.now().astimezone().isoformat(timespec=\"seconds\"),\n    \"center_frequency_hz\": float(self.station_freq),\n    \"sample_rate_hz\": float(self.sample_rate),\n    \"gain_db\": float(self.gain_db),\n    \"fft_size\": int(self.fft_size),\n    \"frequency_resolution_hz\": float(self.vehicle_rate / self.fft_size),\n    \"window_type\": \"blackman-harris\",\n    \"source_device\": \"RTL-SDR EQ-2\",\n    \"scenario\": \"vehicle_30_kmh\",\n    \"expected_speed_kmh\": float(self.vehicle_speed_kmh),\n    \"expected_max_doppler_hz\": float(\n        (self.vehicle_speed_kmh / 3.6)\n        * self.station_freq\n        * 2.0\n        / 299792458.0\n    ),\n    \"geometry_factor_note\": \"\
      Calibrar entre 0 y 2 segun la geometria real\",\n    \"analysis_sample_rate_hz\": float(self.vehicle_rate),\n    \"tuner_center_frequency_hz\": float(self.center_freq)\n}\n\nwith open(config_dir / \"sdr_config.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(config, f, indent=2)\n\nprint(\"Caso vehicular:\", scenario_root)\nprint(\"SDR config guardada en:\", config_dir / \"sdr_config.json\")"
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1040
    - 248.0
    rotation: 0
    state: enabled
